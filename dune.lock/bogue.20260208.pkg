(version 20260208)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune tsdl-image tsdl-ttf ocaml xdg tsdl)))

(source
 (fetch
  (url https://github.com/sanette/bogue/archive/refs/tags/20260208.tar.gz)
  (checksum
   sha512=0b12273a90751c9262d01b0663f910aa4bea8da2a8e26e73ff0e2a3de1eb3d84364ea9a561f537697eab33e03b89728b270fdf3026efca9ae8461822f38c98ed)))
