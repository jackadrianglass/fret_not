(version 0.7)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune ocaml tsdl conf-sdl2-ttf ctypes ctypes-foreign)))

(source
 (fetch
  (url https://github.com/sanette/tsdl-ttf/archive/refs/tags/0.7.tar.gz)
  (checksum
   sha512=36da05d5e177f8ca8c90e9c2515c35deecbff61c1ca7fb1b80110b5c97d4668073a7375f48d441417e956a7c1a9db69592715751bd94f6187483578529c12b2b)))
