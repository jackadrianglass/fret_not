(version 0.6)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune ocaml tsdl conf-sdl2-image ctypes ctypes-foreign dune-configurator)))

(source
 (fetch
  (url https://github.com/sanette/tsdl-image/archive/0.6.tar.gz)
  (checksum
   sha512=af350af0591197bb3a670c1ed93a00f4bc514a7c2d60da309b574756200b6e34b91bf1886fa36f4eb43529cb0c2f715a2bc2c80b66fae6bdcee87e156ffc4f35)))
