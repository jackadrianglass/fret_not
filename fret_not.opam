# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A fret board visualization tool"
description:
  "A quick tool to help come up with exercises for navigating the fret board"
authors: ["Jack Glass <glassjack@proton.me>"]
depends: [
  "dune" {>= "3.23"}
  "ocaml" {= "5.4.1"}
  "base"
  "raylib"
  "raygui"
  "alcotest" {with-test}
  "ocamlformat"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
